<../../../../../mkconfig

TARG=\
	authquery.dis\
	infauth.dis\
	p9any.dis\
	pass.dis\
	rsa.dis\

SYSMODULES=\
	factotum.m\
	keyring.m\
	security.m\
	rand.m\
	sys.m\
	draw.m\
	bufio.m\
	string.m\

MODULES=\
	../authio.m\
	keyreps.m\

DISBIN=$ROOT/dis/auth/proto

<$ROOT/mkfiles/mkdis

# keyreps is loaded from /dis/lib/spki (see keyreps.m)
KEYREPS=$ROOT/dis/lib/spki/keyreps.dis

all:V:	keyreps.dis

install:V:	$KEYREPS

$KEYREPS:	keyreps.dis
	rm -f $KEYREPS && cp keyreps.dis $KEYREPS

nuke:V:
	rm -f $KEYREPS
