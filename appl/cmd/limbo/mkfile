# The compiler and the assembler produce, unless told otherwise (limbo -W),
# code for words of the size of the system they are themselves built for:
# isa.m includes wordsize.m, which is found in w32 or w64.
LIMBOFLAGS=$LIMBOFLAGS -Iw$DISWORD

limbo.dis:	w$DISWORD/wordsize.m
